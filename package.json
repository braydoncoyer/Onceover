{
  "name": "@braydoncoyer/onceover",
  "version": "0.0.0",
  "private": true,
  "description": "A local, read-only git diff viewer for reviewing what coding agents changed.",
  "type": "module",
  "license": "UNLICENSED",
  "bin": {
    "onceover": "bin/onceover.js"
  },
  "files": [
    "bin",
    "dist/ui",
    "dist/node"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -p . && vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p . && tsc -p tsconfig.node.json",
    "preview": "vite preview",
    "screenshot": "node scripts/screenshot.mjs",
    "test": "node --test 'test/**/*.test.ts'",
    "start": "node src/cli.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@pierre/diffs": "^1.6.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=22.18"
  }
}
